PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Connection (Replace with your MongoDB Atlas URI or local instance)
MONGODB_URI=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT Authentication Secret (Mandatory in production: minimum 32 random characters)
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_EXPIRE=30d

# Initial Administrator Provisioning (Optional for setup script)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_this_strong_password_123!
